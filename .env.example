# Real HTTPS domain for the shared backend. Do not put credentials in source control.
HAN_DOMAIN=
HAN_MOBILE_URL=
HAN_ALLOWED_ORIGINS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
HAN_FCM_ENABLED=0
# Set this only in the backend environment after mounting its private credential file.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional owner-managed webhooks: exact trusted HTTPS origins, comma separated.
# Leaving this empty prevents registration and delivery of workspace records.
HAN_WEBHOOK_ALLOWED_ORIGINS=
# Google SSO: backend only. Map approved Google emails or stable sub:<id> to existing HAN user IDs.
HAN_GOOGLE_CLIENT_ID=
HAN_GOOGLE_CLIENT_SECRET=
HAN_GOOGLE_REDIRECT_URI=http://127.0.0.1:5174/api/auth/google/callback
HAN_APP_URL=http://127.0.0.1:5174/
HAN_GOOGLE_ACCOUNTS={}
